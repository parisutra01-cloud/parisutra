{
  "name": "parisutra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "build": "npm run build -w client",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test server/src/utils/mediaOrganization.test.js server/test/unit/*.test.js",
    "test:api": "node --test --test-concurrency=4 server/test/api/*.test.js",
    "test:regression": "node --test --test-concurrency=4 server/test/regression/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 client/test/*.e2e.test.js",
    "test:all": "npm run test:unit; npm run test:api; npm run test:e2e; npm run test:regression"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "razorpay": "^2.9.5",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
